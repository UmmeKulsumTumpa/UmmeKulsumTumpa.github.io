---
import '../styles/global.css';
import Dock from '../components/Dock.astro';
import Footer from '../components/Footer.astro';
import { site, type NavId } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Page highlighted in the dock (none on the 404 page). */
  active?: NavId;
}
const { title, description = site.description, active } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Before paint: apply the saved theme (no flash of the wrong colours), then preload
         the full-size background for that theme (phones use the 1920 WebP instead). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
        } catch (e) {}
        var link = document.createElement('link');
        link.rel = 'preload';
        link.as = 'image';
        link.type = 'image/avif';
        link.href = '/bg/background-' + (root.dataset.theme === 'light' ? 'light' : 'dark') + '.avif';
        link.media = '(min-width: 1101px)';
        link.setAttribute('fetchpriority', 'high');
        document.head.appendChild(link);
      })();
    </script>
    <!-- Before paint: start [data-anim] content in its hidden entrance state so it never shows, hides, then
         animates in (#36). Only when motion is allowed and IntersectionObserver exists, as in motion.ts.
         motion.ts marks html[data-motion="on"]; it is a deferred module, so if it has not started by
         DOMContentLoaded it never will, and everything is shown again. JS disabled: nothing is hidden. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.setAttribute('data-anim-ready', '');
        document.addEventListener('DOMContentLoaded', function () {
          setTimeout(function () {
            if (root.getAttribute('data-motion') === 'on') return;
            root.removeAttribute('data-anim-ready');
            root.setAttribute('data-motion', 'off');
          }, 0);
        });
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body id="top">
    <div class="bg" aria-hidden="true">
      <span class="bg-image"></span>
      <span class="grain"></span>
    </div>

    <slot />

    <Footer />
    <Dock active={active} />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
