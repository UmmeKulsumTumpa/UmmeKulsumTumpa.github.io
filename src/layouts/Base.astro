---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Dock from '../components/Dock.astro';
import Footer from '../components/Footer.astro';
import { site, type NavId } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Page highlighted in the dock (none on the 404 page). */
  active?: NavId;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /** Open Graph type: `article` for writing posts, `website` everywhere else. */
  ogType?: 'website' | 'article';
}
const { title, description = site.description, active, noindex = false, ogType = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
// Not on noindex pages: the 404 page has no real URL of its own to point at.
const canonical = new URL(Astro.url.pathname, Astro.site);
// Shared social preview card (public/og.png, 1200×630): name + role on the dark background.
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Before paint: apply the saved theme (no flash of the wrong colours), then preload
         the full-size background for that theme (phones use the 1920 WebP instead). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') root.dataset.theme = saved;
        } catch (e) {}
        var link = document.createElement('link');
        link.rel = 'preload';
        link.as = 'image';
        link.type = 'image/avif';
        link.href = '/bg/background-' + (root.dataset.theme === 'light' ? 'light' : 'dark') + '.avif';
        link.media = '(min-width: 1101px)';
        link.setAttribute('fetchpriority', 'high');
        document.head.appendChild(link);
      })();
    </script>
    <!-- Before paint: start [data-anim] content in its hidden entrance state so it never shows, hides, then
         animates in (#36). Only when motion is allowed and IntersectionObserver exists, as in motion.ts.
         motion.ts marks html[data-motion="on"]; it is a deferred module, so if it has not started by
         DOMContentLoaded it never will, and everything is shown again. JS disabled: nothing is hidden. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        root.setAttribute('data-anim-ready', '');
        document.addEventListener('DOMContentLoaded', function () {
          setTimeout(function () {
            if (root.getAttribute('data-motion') === 'on') return;
            root.removeAttribute('data-anim-ready');
            root.setAttribute('data-motion', 'off');
          }, 0);
        });
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`Writing · ${site.name}`} href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} · ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-instrument-serif" preload />
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" preload />
  </head>
  <body id="top">
    <div class="bg" aria-hidden="true">
      <span class="bg-image"></span>
      <span class="grain"></span>
    </div>

    <slot />

    <Footer />
    <Dock active={active} />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
