---
import { site } from '../../data/site';

// Icon links of the Home hero and "Say hello." (rulings: icons with an aria-label and a dock-style tooltip).
// Stroke icons on a 24px grid, drawn at 20px with currentColor.
interface Props {
  email?: boolean; // Email first, accented (hero); Contact leaves it out, its button already shows the address
  small?: boolean; // 40px circles (Contact) instead of 46px
}
const { email = true, small = false } = Astro.props;

const links = [
  { id: 'email', name: 'Email', href: `mailto:${site.email}`, d: 'M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 7l9 6 9-6' },
  { id: 'scholar', name: 'Google Scholar', href: site.links.scholar, d: 'M12 3 2 9l10 6 10-6zM6 11.4V15c0 1.7 2.7 3 6 3s6-1.3 6-3v-3.6' },
  {
    id: 'github',
    name: 'GitHub',
    href: site.links.github,
    d: 'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4M9 18c-4.51 2-5-2-7-2',
  },
  { id: 'linkedin', name: 'LinkedIn', href: site.links.linkedin, d: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 2a2 2 0 1 0 0 4a2 2 0 1 0 0-4' },
  { id: 'cv', name: 'CV (PDF)', href: site.links.cv, d: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M12 18v-6M9 15l3 3 3-3' },
].filter((l) => email || l.id !== 'email');
---

<ul class:list={['icon-links', small && 'icon-links-sm']} role="list">
  {links.map((l) => (
    <li>
      <a class:list={['icon-link', l.id === 'email' && 'icon-link-main']} href={l.href} aria-label={l.name}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={l.d} /></svg>
        <span class="icon-link-tip" aria-hidden="true">{l.name}</span>
      </a>
    </li>
  ))}
</ul>
