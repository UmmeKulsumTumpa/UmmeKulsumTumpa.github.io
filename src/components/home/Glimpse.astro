---
import { getCollection } from 'astro:content';

// Live numbers (SPEC §5.1 item 3): counts and latest entries come from the collections.
const projects = await getCollection('projects');
const publications = await getCollection('publications');
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [latest] = posts;
const [book] = await getCollection('reading', ({ data }) => !data.draft && data.status === 'reading');

const numbers = [
  // "2 degrees" stays literal (SPEC §5.1); no collection field states it.
  { n: 2, text: 'degrees at IIT, University of Dhaka' },
  { n: publications.length, text: publications.length === 1 ? 'peer-reviewed paper' : 'peer-reviewed papers' },
  { n: projects.length, text: 'course projects on GitHub' },
];
const stack = ['React', 'Next.js', 'Node.js', 'TypeScript', 'Flutter', 'Firebase'];

// Phones: the bento becomes this numbered list (MobileHome.dc.html), in dock order.
// Entrance delays 0 / 0.06 / 0.12 / 0.18 / 0.24s map to the nearest stagger class.
const list = [
  { n: '01', title: 'Education', href: '/education/', line: "BSc SE, IIT DU · master's in progress.", anim: 'from-left', d: '' },
  { n: '02', title: 'Experience', href: '/experience/', line: 'Associate SE at Cefalo Bangladesh.', anim: 'from-right', d: 'd1' },
  { n: '03', title: 'Research', href: '/research/', line: 'LLM efficiency, context, adaptive inference.', anim: 'from-left', d: 'd2' },
  { n: '04', title: 'Writing', href: '/writing/', line: 'Notes on LLMs and building software.', anim: 'from-right', d: 'd2' },
  { n: '05', title: 'Reading', href: '/reading/', line: "What's on my desk.", anim: 'from-left', d: 'd3' },
];
---

<section class="container glimpse" aria-labelledby="h-glimpse">
  <div class="glimpse-head">
    <div>
      <div class="label" data-anim="blur">§ 02 · around the site</div>
      <h2 id="h-glimpse" class="glimpse-title" data-anim="mask"><span>A glimpse.</span></h2>
    </div>
    <span class="glimpse-hint" data-anim="up">each tile opens its page</span>
  </div>

  <div class="glimpse-bento">
    <a class="glimpse-tile glimpse-edu" data-anim="up" href="/education/">
      <div class="glimpse-tile-in">
        <div class="glimpse-tile-top"><span>01 · education</span><span class="glimpse-arrow" aria-hidden="true">→</span></div>
        <div>
          <div class="glimpse-serif-40">M.Sc. in Software Engineering</div>
          <div class="glimpse-sub">IIT, University of Dhaka · thesis-based · B.Sc. there too</div>
        </div>
        <div>
          <div class="glimpse-progress-label"><span>thesis · adaptive inference</span><span>in progress</span></div>
          <div class="glimpse-progress" aria-hidden="true"><div class="glimpse-progress-bar"></div></div>
        </div>
      </div>
    </a>

    <a class="glimpse-tile glimpse-exp d1" data-anim="up" href="/experience/">
      <div class="glimpse-tile-in">
        <div class="glimpse-tile-top"><span>02 · experience</span><span class="glimpse-arrow" aria-hidden="true">→</span></div>
        <div class="glimpse-exp-row">
          <div class="glimpse-exp-n">4</div>
          <div class="glimpse-exp-text">
            <div class="glimpse-serif-30">production projects</div>
            <div class="glimpse-exp-sub">Cefalo Bangladesh · 2 in-house, 2 client</div>
          </div>
        </div>
        <div class="glimpse-chips">
          {stack.map((s) => <span>{s}</span>)}
          <span class="glimpse-chip-accent">agent-assisted</span>
        </div>
      </div>
    </a>

    <a class="glimpse-tile glimpse-research" data-anim="up" href="/research/">
      <div class="glimpse-tile-in">
        <div class="glimpse-research-text">
          <div class="glimpse-tile-top"><span>03 · research</span><span class="glimpse-arrow" aria-hidden="true">→</span></div>
          <div>
            <div class="glimpse-meta">published · IEEE BigData 2025</div>
            <div class="glimpse-research-title">Voices of Care: LLM-assisted analysis of dementia discourse on Reddit</div>
          </div>
          <div class="glimpse-sub"><span class="accent">now →</span> cross-lingual evaluation of LLM agents in Bangla</div>
        </div>
        <div class="glimpse-bars" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      </div>
    </a>

    <div class="glimpse-numbers d1" data-anim="zoom">
      <div class="glimpse-numbers-in">
        <div class="glimpse-tile-top">by the numbers</div>
        {numbers.map((x) => <div class="glimpse-number"><span class="glimpse-number-n">{x.n}</span><span class="glimpse-number-text">{x.text}</span></div>)}
      </div>
    </div>

    <a class="glimpse-tile glimpse-writing" data-anim="from-left" href="/writing/">
      <div class="glimpse-tile-in">
        <div class="glimpse-tile-top"><span>04 · writing</span><span class="glimpse-arrow" aria-hidden="true">→</span></div>
        <div>
          <div class="glimpse-meta">{latest ? `latest · ${latest.data.date.toISOString().slice(0, 10)}` : 'latest'}</div>
          <div class="glimpse-serif-30 glimpse-title-sm">{latest ? latest.data.title : 'first post coming soon'}</div>
        </div>
        <div class="glimpse-tags">llm · engineering · notes · essays</div>
      </div>
    </a>

    <a class="glimpse-tile glimpse-reading" data-anim="from-right" href="/reading/">
      <div class="glimpse-tile-in">
        <div class="glimpse-reading-text">
          <div class="glimpse-tile-top glimpse-reading-top">05 · reading <span class="glimpse-arrow" aria-hidden="true">→</span></div>
          <div>
            <div class="glimpse-meta">on my desk</div>
            <div class="glimpse-serif-30 glimpse-title-sm">{book ? book.data.title : '[Book title]'}</div>
            <div class="glimpse-author">{book ? book.data.author : '[Author]'}</div>
          </div>
        </div>
        <div class="glimpse-spines" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      </div>
    </a>
  </div>

  <h2 class="glimpse-list-title" data-anim="up">§ a glimpse</h2>
  <ul class="glimpse-list" role="list">
    {list.map((it) => (
      <li>
        <a class:list={['glimpse-item', it.d]} data-anim={it.anim} href={it.href}>
          <span class="glimpse-item-n">{it.n}</span>
          <span class="glimpse-item-body">
            <span class="glimpse-item-title">{it.title}</span>
            <span class="glimpse-item-line">{it.line}</span>
          </span>
          <span class="glimpse-item-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
</section>
