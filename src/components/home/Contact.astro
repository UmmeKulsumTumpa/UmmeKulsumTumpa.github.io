---
import { site } from '../../data/site';
import IconLinks from './IconLinks.astro';
---

<section class="container contact" aria-labelledby="h-contact">
  <h2 id="h-contact" class="contact-title" data-anim="mask"><span>Say hello.</span></h2>
  <div class="contact-actions d2" data-anim="from-right">
    <a class="btn contact-email" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">→</span></a>
    <div class="contact-links"><IconLinks email={false} small /></div>
  </div>
</section>
