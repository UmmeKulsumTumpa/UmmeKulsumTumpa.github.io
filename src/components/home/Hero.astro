---
import { getReading } from '../../lib/reading';
import { site } from '../../data/site';
import LocalTime from '../../islands/LocalTime.tsx';

// Phones show "reading <current book>" in place of the thesis line (MobileHome.dc.html).
// Until a reading entry has status "reading", keep the prototype's placeholder.
const current = (await getReading()).find(({ data }) => data.status === 'reading');
const book = current?.data.title ?? '[book title]';

// Top line: phones show the short one from MobileHome.dc.html, "~/ukt" and "Dhaka · HH:MM" (.hero-wide / .hero-phone).

// Two masked lines (given name, family name): one line on desktop, stacked on phones (MobileHome.dc.html).
const cut = site.name.lastIndexOf(' ');
const [nameStart, nameEnd] = [site.name.slice(0, cut), site.name.slice(cut + 1)];
---

<section class="hero" aria-labelledby="h-hero">
  <div class="hero-grid" data-parallax="0.3" aria-hidden="true"></div>
  <div class="hero-ghost" data-parallax="0.45" aria-hidden="true">context</div>

  <div class="container hero-inner">
    <div class="hero-top" data-anim="blur">
      <a class="hero-path tap-target" href="/"><span class="hero-wide">~/{site.handle}</span><span class="hero-phone">~/{site.handleShort}</span></a>
      <span><span class="hero-wide">Dhaka, BD</span><span class="hero-phone">Dhaka</span> · <LocalTime client:idle timeZone={site.timezone} /><span class="hero-wide"> (UTC+6)</span></span>
    </div>

    <div class="hero-name-block">
      <div class="hero-hello" data-anim="blur">hello, I'm</div>
      <h1 id="h-hero" class="hero-name">
        <span class="hero-name-line" data-anim="mask"><span class="d1">{nameStart}</span></span>{' '}
        <span class="hero-name-line" data-anim="mask"><span class="hero-name-end d3">{nameEnd}<span class="caret" aria-hidden="true"></span></span></span>
      </h1>
      <div class="hero-role d5" data-anim="from-left">
        <span>Software Engineer</span><span class="accent" aria-hidden="true">·</span><span>Researcher</span>
      </div>
    </div>

    <div class="hero-bottom">
      <p class="hero-statement d6" data-anim="up">{site.statement}</p>
      <div class="hero-now d7" data-anim="from-right">
        <div class="hero-now-label"><span class="pulse" aria-hidden="true"></span>currently</div>
        <div>building at <a class="hero-now-value tap-target" href="https://cefalo.com">{site.currently.building}</a></div>
        <div>researching at <span class="hero-now-value">{site.currently.researching}</span></div>
        <div class="hero-now-thesis">thesis on <span class="hero-now-value">{site.currently.thesis}</span></div>
        <div class="hero-now-reading">reading <span class="hero-now-value">{book}</span></div>
      </div>
    </div>
  </div>
</section>
