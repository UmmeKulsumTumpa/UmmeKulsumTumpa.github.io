---
import { site } from '../../data/site';
import { Image } from 'astro:assets';
import portrait from '../../assets/portrait.jpg';
import LocalTime from '../../islands/LocalTime.tsx';
import IconLinks from './IconLinks.astro';

// Two masked lines (given name, family name): one line on desktop, stacked on phones (MobileHome.dc.html).
const cut = site.name.lastIndexOf(' ');
const [nameStart, nameEnd] = [site.name.slice(0, cut), site.name.slice(cut + 1)];

// The bio's named entities are set in the text colour (plain text, not links: colour alone must not mark a link).
const marks = ['Cefalo Bangladesh', 'IIT, University of Dhaka', 'BARTA Research Lab', 'adaptive inference for efficient LLMs'];
const bio = site.bio
  .split(new RegExp(`(${marks.map((m) => m.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`))
  .filter(Boolean)
  .map((text) => ({ text, mark: marks.includes(text) }));

---

<section class="hero" aria-labelledby="h-hero">
  <div class="container hero-inner">
    {/* Top line: the full path on every width, like the other pages' breadcrumb; phones shorten only the place ("Dhaka · HH:MM"). */}
    <div class="hero-top" data-anim="blur">
      <a class="hero-path tap-target" href="/">~/{site.handle}</a>
      <span><span class="hero-wide">Dhaka, BD</span><span class="hero-phone">Dhaka</span> · <LocalTime client:idle timeZone={site.timezone} /><span class="hero-wide"> (UTC+6)</span></span>
    </div>

    <div class="hero-main">
      <div class="hero-text">
        <div class="hero-hello" data-anim="blur">hello, I'm</div>
        <h1 id="h-hero" class="hero-name">
          <span class="hero-name-line" data-anim="mask"><span class="d1">{nameStart}</span></span>{' '}
          <span class="hero-name-line" data-anim="mask"><span class="hero-name-end d3">{nameEnd}<span class="caret" aria-hidden="true"></span></span></span>
        </h1>
        <div class="hero-role d5" data-anim="from-left">
          <span>Software Engineer</span><span class="accent" aria-hidden="true">·</span><span>Researcher</span>
        </div>
        <p class="hero-bio d6" data-anim="up">
          {bio.map(({ text, mark }) => (mark ? <span class="hero-mark">{text}</span> : text))}
        </p>
        <p class="hero-statement d6" data-anim="up">{site.statement}</p>
        <div class="hero-links d7" data-anim="up"><IconLinks /></div>
      </div>

      <figure class="hero-portrait d5" data-anim="zoom">
        <Image class="hero-portrait-img" src={portrait} alt={site.name} width={300} densities={[1, 2]} format="webp" loading="eager" />
        <figcaption><span>{site.name}</span><span>Dhaka, 2026</span></figcaption>
      </figure>
    </div>
  </div>
</section>
