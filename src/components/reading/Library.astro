---
import { getCollection } from 'astro:content';
import ReadingLibrary from '../../islands/ReadingLibrary.tsx';

// Every non-draft reading entry: reading first, then finished, then queued (as in Reading.dc.html),
// A–Z by file name within each. An entry with a Markdown body has notes, at /reading/<id>/.
const rank = { reading: 0, finished: 1, queued: 2 };
const entries = (await getCollection('reading', ({ data }) => !data.draft)).sort(
  (a, b) => rank[a.data.status] - rank[b.data.status] || a.id.localeCompare(b.id),
);
const items = entries.map(({ id, body, data }) => ({
  slug: id,
  title: data.title,
  author: data.author,
  kind: data.kind,
  status: data.status,
  topic: data.topic,
  year: data.year === undefined ? undefined : String(data.year),
  why: data.why,
  notes: Boolean(body?.trim()),
}));
---

<ReadingLibrary client:visible items={items} heading="h-library" />
