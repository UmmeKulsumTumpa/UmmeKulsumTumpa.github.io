---
interface Props {
  slug: string; // breadcrumb, e.g. "education"; also adds the .ph-<slug> hook for page CSS
  title: string;
  phoneCrumb?: boolean; // phones show the short crumb "← ~/<slug>" (MobileReading.dc.html)
}
const { slug, title, phoneCrumb = false } = Astro.props;
// A "lead-phone" slot replaces the lead on phones (MobileReading.dc.html).
const phoneLead = Astro.slots.has('lead-phone');
---

<header class:list={['ph', `ph-${slug}`]}>
  <div class="container ph-inner">
    <a class="ph-crumb tap-target" data-anim="blur" href="/">
      {phoneCrumb ? (
        <><span class="ph-wide">~/ummekulsumtumpa/{slug}</span><span class="ph-phone"><span aria-hidden="true">← </span>~/{slug}</span></>
      ) : (
        `~/ummekulsumtumpa/${slug}`
      )}
    </a>
    <div class="ph-text">
      <h1 class="ph-title" data-anim="mask" data-parallax="0.08"><span class="d1">{title}</span></h1>
      <p class="ph-lead d4" data-anim="up">
        {phoneLead ? (
          <><span class="ph-wide"><slot /></span><span class="ph-phone"><slot name="lead-phone" /></span></>
        ) : (
          <slot />
        )}
      </p>
      <slot name="after-lead" />
    </div>
    <slot name="after" />
  </div>
</header>
