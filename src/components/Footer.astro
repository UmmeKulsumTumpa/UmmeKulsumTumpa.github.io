---
import { site } from '../data/site';

// Year and "last updated" are the build date (Dhaka time), so every deploy refreshes them.
const now = new Date();
const year = new Intl.DateTimeFormat('en', { timeZone: site.timezone, year: 'numeric' }).format(now);
const updated = new Intl.DateTimeFormat('en-CA', { timeZone: site.timezone, year: 'numeric', month: '2-digit', day: '2-digit' }).format(now);
---

<footer class="footer">
  <span>© {year} {site.name} · last updated <time datetime={updated}>{updated}</time></span>
  <span>hosted on GitHub Pages · <a class="footer-top" href="#top">top ↑</a></span>
</footer>
