---
// "03 · toolbox" (Experience.dc.html; SPEC §5.3): Web, Mobile, Research, Practice. Copy verbatim from the
// prototype, [bracket placeholders] included. Entrance delays 0 / 0.08 / 0.16 / 0.24s = '' / d1 / d2 / d3.
const columns = [
  { name: 'Web', items: ['React', 'Next.js', 'Node.js · Express', 'TypeScript'] },
  { name: 'Mobile', items: ['Flutter', 'Dart', 'Firebase'] },
  { name: 'Research', items: ['LLMs · NLP', 'AI agents', '[your ML stack]'] },
  { name: 'Practice', items: ['spec-driven development', 'agent-assisted workflows', 'skills · hooks · plugins', 'code review'] },
];
const delays = ['', 'd1', 'd2', 'd3'];
---

<section class="exp-section tool" aria-labelledby="h-tools">
  <h2 id="h-tools" class="label tool-heading" data-anim="up">03 · toolbox</h2>
  <div class="tool-grid">
    {columns.map((c, i) => (
      <div class:list={['tool-col', delays[i]]} data-anim="up">
        <h3 class="tool-name">{c.name}</h3>
        <ul class="tool-list" role="list">
          {c.items.map((it) => <li>{it}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
