---
// "02 · selected projects" (Experience.dc.html; SPEC §5.3). Copy is verbatim from the prototype,
// [bracket placeholders] included. Every card is one card: screenshot (16:10), meta, title ↗, one line, stack.
// The whole card is clickable through the title link's stretched ::after, so links inside the line
// (e.g. "React frontend") are siblings, not nested anchors (the nesting caused the prototype glitch).
type Part = string | { text: string; href: string };
interface Project {
  title: string;
  href: string;
  meta?: string;
  line: Part[];
  stack: string;
}

const projects: Project[] = [
  {
    title: 'Cefalo Travel Connect',
    href: 'https://github.com/UmmeKulsumTumpa/CefaloTravelConnect',
    meta: 'Cefalo · [training / in-house]',
    line: [
      '[One line: what it does.] API plus a ',
      { text: 'React frontend', href: 'https://github.com/UmmeKulsumTumpa/ctc-frontend' },
      '.',
    ],
    stack: 'Express · TypeScript · Knex · PostgreSQL · React · Tailwind',
  },
  {
    title: '[Project name]',
    href: '#',
    line: ['[One line: what it does, for whom, and the result.]'],
    stack: '[stack]',
  },
];
---

<section class="exp-section proj" aria-labelledby="h-proj">
  <div class="proj-head" data-anim="up">
    <h2 id="h-proj" class="label proj-heading">02 · selected projects</h2>
    <a class="proj-all" href="https://github.com/UmmeKulsumTumpa?tab=repositories">all repos&nbsp;<span aria-hidden="true">↗</span></a>
  </div>
  <div class="proj-grid">
    {projects.map((p, i) => (
      <article class:list={['proj-card', i % 2 === 1 && 'd1']} data-anim="zoom">
        {/* No screenshots yet: dotted 16:10 placeholder. Swap in Astro <Image> once real images exist. */}
        <div class="proj-media">
          <div class="proj-shot" role="img" aria-label="Project screenshot placeholder">[screenshot]</div>
        </div>
        <div class="proj-body">
          {p.meta && <div class="proj-meta">{p.meta}</div>}
          <h3 class="proj-title">
            <a class="proj-link" href={p.href}>{p.title} <span aria-hidden="true">↗</span></a>
          </h3>
          <p class="proj-line">
            {p.line.map((part) => (typeof part === 'string' ? part : <a class="proj-inline" href={part.href}>{part.text}</a>))}
          </p>
          <div class="proj-stack">{p.stack}</div>
        </div>
      </article>
    ))}
  </div>
</section>
