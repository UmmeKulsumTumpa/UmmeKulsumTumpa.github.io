---
import ThemeToggle from '../islands/ThemeToggle.tsx';
import { nav, site, type NavId } from '../data/site';

interface Props { active?: NavId }
const { active } = Astro.props;

const icons: Record<NavId, string> = {
  home: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z',
  education: 'M2 9l10-5 10 5-10 5zM6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5M22 9v6',
  experience: 'M4 7h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1zM8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18',
  research: 'M9 3h6M10 3v6l-5.6 9.6A1.6 1.6 0 0 0 5.8 21h12.4a1.6 1.6 0 0 0 1.4-2.4L14 9V3M7.5 15h9',
  writing: 'M4 20h4L19 9a2.8 2.8 0 0 0-4-4L4 16v4zM13.5 6.5l4 4',
  reading: 'M3 5h6a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H3zM21 5h-6a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h7z',
};
---

<div class="dock-wrap">
  <nav class="dock" aria-label="Site">
    {nav.map((item) => (
      <a class="dock-item" href={item.href} aria-label={item.label} aria-current={item.id === active ? 'page' : undefined}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[item.id]} /></svg>
        <span class="dock-dot" aria-hidden="true"></span>
        <span class="dock-tip" aria-hidden="true">{item.label}</span>
      </a>
    ))}
    <span class="dock-sep" aria-hidden="true"></span>
    <a class="dock-item dock-email" href={`mailto:${site.email}`} aria-label="Email me">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 7l9 6 9-6" /></svg>
      <span class="dock-tip" aria-hidden="true">Email</span>
    </a>
    <ThemeToggle client:load />
  </nav>
</div>
