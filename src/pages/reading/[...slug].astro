---
// Notes page per reading entry that has a Markdown body (SPEC §5.6). Entries come from getReading(),
// so drafts get no page in production; entries without notes get none at all.
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProseArticle from '../../components/ProseArticle.astro';
import { getReading, hasNotes } from '../../lib/reading';

export async function getStaticPaths() {
  const entries = (await getReading()).filter(hasNotes);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'reading'>;
}
const { entry } = Astro.props;
const { title, author, kind, status, year, why } = entry.data;
const { Content } = await render(entry);
const meta = [kind, status, year].filter((part) => part !== undefined).join(' · ');
---
<Base title={title} description={why} active="reading">
  <main>
    <ProseArticle back={{ href: '/reading/', label: 'the library' }} meta={meta} title={title} lead={author}>
      <Content />
    </ProseArticle>
  </main>
</Base>
