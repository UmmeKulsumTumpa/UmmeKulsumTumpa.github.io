---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ExperienceTimeline from '../components/experience/ExperienceTimeline.astro';
import SelectedProjects from '../components/experience/SelectedProjects.astro';
import Toolbox from '../components/experience/Toolbox.astro';
// Page lead: shown under the title and used as the meta description.
const lead = 'Three roles at Cefalo Bangladesh, from intern to full-time engineer, and research at BARTA Lab.';
---
<Base
  title="Experience"
  description={lead}
  active="experience"
>
  <main>
    <PageHead slug="experience" title="Experience" ghost="ship it">
      {lead}
    </PageHead>
    <div class="container">
      <ExperienceTimeline />
      <SelectedProjects />
      <Toolbox />
    </div>
  </main>
</Base>
