---
// Featured post, then all posts with the tag filter. The post page and RSS come in #20.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import FeaturedPost from '../components/writing/FeaturedPost.astro';
import PostList from '../components/writing/PostList.astro';
---
<Base title="Writing" active="writing">
  <PageHead slug="writing" title="Writing" ghost="notes" italicGhost>
    Notes on LLMs, building software, and the books and ideas I can't stop thinking about. [Posting cadence, if you want to commit to one.]
    <div class="writing-feeds" slot="after-lead">
      <a href="/rss.xml">rss ↗</a>
      <a href="#">subscribe by email ↗</a>
    </div>
  </PageHead>
  <main class="container">
    <FeaturedPost />
    <PostList />
  </main>
</Base>
