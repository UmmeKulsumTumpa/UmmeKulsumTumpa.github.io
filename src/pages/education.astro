---
// Timeline, course-project archive, then awards & activities + hackathons & contests.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import EducationTimeline from '../components/education/EducationTimeline.astro';
import CourseArchive from '../components/education/CourseArchive.astro';
import Activities from '../components/education/Activities.astro';
---
<Base
  title="Education"
  description="A thesis-based M.Sc. in progress and a B.Sc. in Software Engineering at IIT, University of Dhaka, after SSC and HSC in science."
  active="education"
>
  <main>
    <PageHead slug="education" title="Education" ghost="learning" italicGhost>
      A thesis-based M.Sc. in progress and a B.Sc. in Software Engineering at IIT, University of Dhaka, after SSC and HSC in science.
    </PageHead>
    <div class="container">
      <EducationTimeline />
      <CourseArchive />
      <Activities />
    </div>
  </main>
</Base>
