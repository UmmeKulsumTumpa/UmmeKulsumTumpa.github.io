---
/**
 * LinkedIn-style timeline. One entry per organisation; several roles in one
 * entry are joined by a line ("connected dots"). Order comes from the YAML file.
 */
interface Role {
  title: string; type?: string; start: string; end?: string; current: boolean;
  summary?: string; bullets: string[]; details: { label: string; value: string }[];
  courses: { name: string; note: string }[];
}
interface Entry { org: string; short: string; url?: string; location: string; span: string; roles: Role[] }
interface Props { entries: Entry[]; label: string; hint: string; currentLabel?: string }

const { entries, label, hint, currentLabel = 'current' } = Astro.props;
---

<div class="section-head" data-anim="up">
  <h2 class="label">{label}</h2>
  <span class="label">{hint}</span>
</div>
<ol class="timeline">
  {entries.map((e) => (
    <li class="tl-org" data-anim="up">
      <div class:list={['tl-logo', e.short.length > 1 && 'text']} aria-hidden="true">{e.short}</div>
      <div class="tl-body">
        <div class="tl-head">
          <h3>{e.url ? <a href={e.url}>{e.org}</a> : e.org}</h3>
          <span class="tl-meta">{e.location} · {e.span}</span>
        </div>
        {e.roles.map((r, i) => (
          <div class="tl-role">
            <span class:list={['tl-dot', r.current && 'current']} aria-hidden="true"></span>
            {i < e.roles.length - 1 && <span class="tl-line" aria-hidden="true"></span>}
            <div class="tl-title">
              <span>{r.title}</span>
              {r.current && <span class="tl-badge">{currentLabel}</span>}
            </div>
            <div class="tl-when">{r.end || r.current ? `${r.start} → ${r.current ? 'present' : r.end}` : r.start}{r.type && ` · ${r.type}`}</div>
            {r.summary && <p class="tl-text">{r.summary}</p>}
            {r.bullets.length > 0 && <ul class="tl-list">{r.bullets.map((b) => <li>{b}</li>)}</ul>}
            {r.details.length > 0 && (
              <div class="tl-details">{r.details.map((d) => <div><span class="label-sm">{d.label} · </span>{d.value}</div>)}</div>
            )}
            {r.courses.length > 0 && (
              <div class="tl-courses">
                {r.courses.map((c) => (
                  <div class="card"><div class="tl-course-name">{c.name}</div><div class="tl-course-note">{c.note}</div></div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </li>
  ))}
</ol>
