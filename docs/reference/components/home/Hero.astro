---
import { site } from '../../data/site';
import LocalTime from '../../islands/LocalTime.tsx';
---

<section class="hero" aria-label="Introduction">
  <div class="hero-grid" data-parallax="0.3" aria-hidden="true"></div>
  <div class="hero-ghost" data-parallax="0.45" aria-hidden="true">context</div>

  <div class="container hero-inner">
    <div class="hero-top label" data-anim="blur">
      <a href="/">~/{site.handle}</a>
      <span>Dhaka, BD · <LocalTime client:idle timeZone={site.timezone} /> (UTC+6)</span>
    </div>

    <div class="hero-name-block">
      <div class="hero-hello" data-anim="blur">hello, I'm</div>
      <h1 class="hero-name">
        <span data-anim="mask"><span class="d1">{site.name}<span class="caret" aria-hidden="true"></span></span></span>
      </h1>
      <div class="hero-role d5" data-anim="from-left">
        <span>Software Engineer</span><span class="accent" aria-hidden="true">·</span><span>Researcher</span>
      </div>
    </div>

    <div class="hero-bottom">
      <p class="hero-statement d6" data-anim="up">{site.statement}</p>
      <div class="hero-now d7" data-anim="from-right">
        <div class="hero-now-label"><span class="pulse" aria-hidden="true"></span>currently</div>
        <div>building at <a href="https://cefalo.com">{site.currently.building}</a></div>
        <div>researching at <span>{site.currently.researching}</span></div>
        <div>thesis on <span>{site.currently.thesis}</span></div>
      </div>
    </div>
  </div>
</section>
